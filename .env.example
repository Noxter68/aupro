# Clé API Resend (https://resend.com/api-keys) — permission "Full access" pour pouvoir écrire les contacts.
RESEND_API_KEY=

# Audience (segment) Resend qui reçoit les inscriptions à la bêta. Créée automatiquement si elle n’existe pas.
RESEND_AUDIENCE_NAME=aupro-beta

# Optionnel : identifiant du segment, si vous préférez le fixer plutôt que de le résoudre par son nom.
RESEND_AUDIENCE_ID=
